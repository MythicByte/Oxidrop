  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "description": "What to do with a list",
        "enum": [
          "Allow",
          "Deny"
        ]
      },
      "AllowListState": {
        "type": "object",
        "required": [
          "action",
          "last_seen"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "last_seen": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AllowListV4Update": {
        "type": "object",
        "required": [
          "key",
          "state"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/Ipv4Packet"
          },
          "state": {
            "$ref": "#/components/schemas/AllowListState"
          }
        }
      },
      "AllowListV6Update": {
        "type": "object",
        "required": [
          "key",
          "state"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/Ipv6Packet"
          },
          "state": {
            "$ref": "#/components/schemas/AllowListState"
          }
        }
      },
      "AppUser": {
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "permissions",
          "password_hash"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "password_hash": {
            "type": "string"
          },
          "permissions": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "role": {
            "$ref": "#/components/schemas/RolesUser"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ConfigPatch": {
        "type": "object",
        "properties": {
          "ddos_activated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "default_profile": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RateProfile"
              }
            ]
          },
          "icmp_profile": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RateProfile"
              }
            ]
          },
          "incoming_ethernet_adapter": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "output_ethernet_adapter": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "protcol_allowed": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "tcp_profile": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RateProfile"
              }
            ]
          },
          "udp_profile": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RateProfile"
              }
            ]
          }
        }
      },
      "CreateUserReq": {
        "type": "object",
        "required": [
          "username",
          "password",
          "role",
          "permissions"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "permissions": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "role": {
            "$ref": "#/components/schemas/RolesUser"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "DeleteUserReq": {
        "type": "object",
        "required": [
          "target_username"
        ],
        "properties": {
          "target_username": {
            "type": "string"
          }
        }
      },
      "Ipv4Packet": {
        "type": "object",
        "description": "Tightly packed 5-Tuple for IPv4 state tracking\nTotal size: 16 bytes (Strictly aligned)",
        "required": [
          "source_addr",
          "destination_addr",
          "source_port",
          "destination_port",
          "protocol"
        ],
        "properties": {
          "_pad": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "_pad2": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "destination_addr": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "destination_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "protocol": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "source_addr": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "source_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Ipv6Packet": {
        "type": "object",
        "description": "Tightly packed 5-Tuple for IPv6 state tracking\nTotal size: 40 bytes (Strictly aligned)",
        "required": [
          "source_addr",
          "destination_addr",
          "source_port",
          "destination_port",
          "protocol"
        ],
        "properties": {
          "_pad": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          "destination_addr": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          "destination_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "protocol": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "source_addr": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          "source_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ModifyUserReq": {
        "type": "object",
        "required": [
          "target_username",
          "role",
          "permissions",
          "is_active"
        ],
        "properties": {
          "is_active": {
            "type": "integer",
            "format": "int64"
          },
          "permissions": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "role": {
            "$ref": "#/components/schemas/RolesUser"
          },
          "target_username": {
            "type": "string"
          }
        }
      },
      "PacketCountV4Update": {
        "type": "object",
        "required": [
          "key",
          "state"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/Ipv4Packet"
          },
          "state": {
            "$ref": "#/components/schemas/TokenBucketState"
          }
        }
      },
      "PacketCountV6Update": {
        "type": "object",
        "required": [
          "key",
          "state"
        ],
        "properties": {
          "key": {
            "$ref": "#/components/schemas/Ipv6Packet"
          },
          "state": {
            "$ref": "#/components/schemas/TokenBucketState"
          }
        }
      },
      "Permission": {
        "type": "string",
        "enum": [
          "Create",
          "Modify",
          "Delete"
        ]
      },
      "RateProfile": {
        "type": "object",
        "description": "Bucket State for Rate Limiting",
        "required": [
          "rate_shift",
          "burst"
        ],
        "properties": {
          "burst": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "rate_shift": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "RenameUserReq": {
        "type": "object",
        "required": [
          "current_username",
          "new_username"
        ],
        "properties": {
          "current_username": {
            "type": "string"
          },
          "new_username": {
            "type": "string"
          }
        }
      },
      "RolesUser": {
        "type": "string",
        "enum": [
          "Viewer",
          "Admin"
        ]
      },
      "SubnetMatchV4Update": {
        "type": "object",
        "required": [
          "network",
          "prefix_len",
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "network": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "prefix_len": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "SubnetMatchV6Update": {
        "type": "object",
        "required": [
          "network",
          "prefix_len",
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "network": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          "prefix_len": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "TokenBucketState": {
        "type": "object",
        "description": "The ddos protection bucket",
        "required": [
          "tokens",
