{
  "openapi": "3.1.0",
  "info": {
    "title": "Oxidrop Firewall API",
    "description": "Core API for the Oxidrop firewall system",
    "license": {
      "name": "GPL-2.0-only",
      "identifier": "GPL-2.0-only"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/config": {
      "get": {
        "tags": [
          "crate::state"
        ],
        "summary": "get config from the firewall",
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Get current firewall configuration"
          }
        },
        "security": [
          {
            "cookie_auth": []
          }
        ]
      },
      "post": {
        "tags": [
          "crate::state"
        ],
        "summary": "update firewall config",
        "operationId": "update_config",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Config updated successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "cookie_auth": []
          }
        ]
      }
    },
